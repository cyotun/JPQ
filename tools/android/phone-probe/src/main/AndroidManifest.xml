<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="com.cyotun.jpq.scopeoverlay.BIND_PROBE" />
    <queries><package android:name="com.cyotun.jpq.scopeoverlay" /></queries>
    <application android:label="记牌器手机测试" android:allowBackup="false">
        <activity android:name="com.cyotun.jpq.vision.PhoneFrameProbeActivity"
            android:exported="true" android:launchMode="singleTop" />
        <activity android:name="com.cyotun.jpq.vision.ScopeProbeActivity"
            android:exported="true" android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density" />
        <activity android:name="com.cyotun.jpq.vision.ScopeConsentActivity"
            android:exported="false" android:excludeFromRecents="true"
            android:taskAffinity="com.cyotun.jpq.tests.scopeconsent"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density" />
        <service android:name="com.cyotun.jpq.vision.ScopeProbeService"
            android:exported="false" android:foregroundServiceType="mediaProjection" />
    </application>
    <instrumentation android:name="com.cyotun.jpq.vision.PhoneCaptureUiDriver"
        android:targetPackage="com.cyotun.jpq.tests" android:functionalTest="false" />
</manifest>
